# Copy to apps/api/.env. Defaults work with `supabase start`.

APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Supabase: `supabase status` prints the local API URL.
SUPABASE_URL=http://127.0.0.1:54321
# Only needed if your project signs JWTs with the legacy HS256 secret
# (`supabase status` shows it as "JWT secret"). Leave empty for asymmetric keys.
SUPABASE_JWT_SECRET=

# Used from Phase 1 onwards.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# The dragon's AI (Phase 6). "ollama" talks to Ollama on this machine; "fake" gives canned
# replies. A ":cloud" model runs on Ollama's servers (sign in with `ollama signin`); a local
# model such as llama3.2:3b needs `ollama pull llama3.2:3b` and a few GB of free RAM.
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=nemotron-3-super:cloud
# Thinking models spend the reply budget on thinking; leave this off for chat.
OLLAMA_THINK=false
CHAT_DAILY_LIMIT=100
